# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyw
.Python
py.typed
.mypy_cache

# Instalação e build
*.egg
*.egg-info/
dist/
build/
wheels/
sdist/
.eggs/
MANIFEST

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# -----------------------------------------------------------------------------
